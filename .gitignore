# Secrets / credentials — NEVER commit these
.env
!.env.example

# snmp_exporter generated config (real community strings live here) -- see the
# commented mount block in docker-compose.yml
snmp_exporter/snmp.yml

# Third-party MIB source files -- large, re-downloadable via fetch-mibs.sh,
# not something to vendor into the repo
snmp_exporter/generator/mibs/

# Alertmanager notifier secrets (webhook URL / SMTP password) -- see the
# commented receivers in alertmanager/alertmanager.yml
alertmanager/secrets/*
!alertmanager/secrets/.gitkeep

# Generated by scripts/export_config_drift.py -- host-specific runtime data, not source
textfile_collector/*.prom
textfile_collector/*.prom.tmp
!textfile_collector/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

#Claude
CLAUDE.local.md
.claude/settings.local.json
