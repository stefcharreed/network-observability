{
  "title": "Network Overview",
  "uid": "net-overview",
  "tags": ["network", "snmp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Interface Throughput — In (bps)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ifHCInOctets[5m]) * 8",
          "legendFormat": "{{instance}} {{ifDescr}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Interface Throughput — Out (bps)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ifHCOutOctets[5m]) * 8",
          "legendFormat": "{{instance}} {{ifDescr}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Device CPU (%) — needs CISCO-PROCESS-MIB module in snmp.yml",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cpmCPUTotal5minRev",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Config Drift (config-audit)",
      "description": "Devices with detected config drift. See README's \"If drift fires\" for what to do next.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "config_audit_devices_drifted",
          "legendFormat": "drifted devices"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Drifted Devices (config-audit)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "config_audit_device_drift",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
